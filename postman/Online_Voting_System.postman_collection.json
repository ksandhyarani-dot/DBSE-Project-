  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Voter Authentication & OTP",
      "item": [
        {
          "name": "Step 1: Request Aadhaar-Style OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voterId\": \"{{demoVoterId}}\",\n  \"mobileNumber\": \"{{demoMobile}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/voters/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voters", "request-otp"]
            },
            "description": "Validates voter roll entry and dispatches simulated 6-digit OTP to masked mobile. Notice: OTP value is never returned in response."
          },
          "response": []
        },
        {
          "name": "Step 2: Verify OTP Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voterId\": \"{{demoVoterId}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/voters/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voters", "verify-otp"]
            },
            "description": "Authenticates the 6-digit OTP and unlocks the electronic ballot. For academic evaluation, code 123456 is pre-accepted."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Ballot & Candidates",
      "item": [
        {
          "name": "Get All Contesting Candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "candidates"]
            },
            "description": "Returns all registered candidates with symbols, agendas, and current votes."
          },
          "response": []
        },
        {
          "name": "Cast Electronic Ballot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voterId\": \"{{demoVoterId}}\",\n  \"candidateId\": \"{{demoCandidateId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ballot/cast",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ballot", "cast"]
            },
            "description": "Submits single vote. Atomically locks voter to VOTED and generates tamper-evident receipt token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Election Results & Analytics",
